# Copy to .env and fill in. Never commit .env.

# ---- App ----
APP_ENV=development                 # development | production
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-development-only
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database (local MySQL or Amazon RDS MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dragonwok
DB_USER=dragonwok
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too        # only used by docker-compose MySQL
# For RDS: path to the AWS RDS CA bundle. Certificate and host name are verified.
# DB_SSL_CA=/certs/global-bundle.pem
DB_SSL_VERIFY=true

# ---- Business rules ----
DELIVERY_FEE=40.00
TAX_PERCENT=5.00

# ---- First admin account (created by the seed script if ADMIN_PASSWORD is set) ----
ADMIN_EMAIL=admin@dragonwok.local
ADMIN_PASSWORD=

# ---- Frontend build ----
VITE_API_URL=http://localhost:8000/api/v1
